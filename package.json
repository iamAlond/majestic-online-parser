{
  "name": "majestic-online-parser",
  "version": "1.0.1",
  "description": "A convenient singleton parser for online players in majestic projects",
  "author": "Alond",
  "contributors": [
    "Matvey iamAlond"
  ],
  "license": "MIT",
  "keywords": [
    "majestic",
    "role-play",
    "russia-online",
    "majestic-roleplay",
    "online"
  ],
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "release": "release-it",
    "commit": "cz",
    "start": "node .",
    "dev": "tsx watch src/main.ts",
    "build": "tsc"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "fastify": "^5.12.7",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=11.1.2"
  }
}
